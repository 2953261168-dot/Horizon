{
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash",
    "api_key_env": "ZHIPU_API_KEY",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "temperature": 0.1,
    "max_tokens": 4096,
    "throttle_sec": 2,
    "languages": [
      "zh",
      "en"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "world-news": {
        "threshold": 6.0,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 24,
    "profile_order": [
      "world-news",
      "finance-news",
      "tech-news"
    ],
    "category_groups": {
      "world": {
        "name": "国际与公共事务",
        "limit": 8,
        "categories": [
          "world"
        ]
      },
      "finance": {
        "name": "财经与政策",
        "limit": 8,
        "categories": [
          "finance"
        ]
      },
      "tech": {
        "name": "科技与研究",
        "limit": 8,
        "categories": [
          "tech"
        ]
      }
    },
    "default_group_limit": 4
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "imap_server": "imap.163.com",
    "imap_port": 993,
    "email_address": "${HORIZON_EMAIL_ADDRESS}",
    "password_env": "SMTP_PASSWORD",
    "recipients": [
      "${HORIZON_EMAIL_ADDRESS}"
    ],
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE",
    "imap_enabled": false,
    "languages": [
      "zh"
    ]
  },
  "sources": {
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "profile": "tech-news"
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "金融时报 (FT)",
        "url": "https://www.ft.com/rss/home",
        "enabled": true,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "华尔街日报 (WSJ) - 市场",
        "url": "https://feeds.a.dj.com/rss/RSSMarketsMain.xml",
        "enabled": true,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "哈佛商业评论 (HBR)",
        "url": "https://feeds.harvardbusiness.org/harvardbusiness/",
        "enabled": false,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "经济学人 - 财经",
        "url": "https://www.economist.com/finance-and-economics/rss.xml",
        "enabled": true,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "麦肯锡洞察",
        "url": "https://www.mckinsey.com/Insights/rss.aspx",
        "enabled": true,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "36氪 - 深度",
        "url": "https://36kr.com/feed",
        "enabled": false,
        "profile": "finance-news",
        "category": "finance"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
