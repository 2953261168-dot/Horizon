{
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash",
    "api_key_env": "ZHIPU_API_KEY",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "temperature": 0.1,
    "max_tokens": 4096,
    "throttle_sec": 2,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "world-news": {
        "threshold": 6.0,
        "topic_dedup": true
      },
      "culture-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "life-news": {
        "threshold": 6,
        "topic_dedup": true
      },
      "research-news": {
        "threshold": 6,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "life-news",
      "culture-news",
      "finance-news",
      "tech-news",
      "research-news",
      "world-news"
    ],
    "category_groups": {
      "world": {
        "name": "国际与公共事务",
        "limit": 1,
        "categories": [
          "world"
        ]
      },
      "finance": {
        "name": "财经与政策",
        "limit": 4,
        "categories": [
          "finance"
        ]
      },
      "tech": {
        "name": "科技与研究",
        "limit": 4,
        "categories": [
          "tech"
        ]
      },
      "culture": {
        "name": "文化与热议",
        "limit": 5,
        "categories": [
          "culture"
        ]
      },
      "life": {
        "name": "生活与社会",
        "limit": 4,
        "categories": [
          "life"
        ]
      },
      "research": {
        "name": "研究与新知",
        "limit": 2,
        "categories": [
          "research"
        ]
      }
    },
    "default_group_limit": 4
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "imap_server": "imap.163.com",
    "imap_port": 993,
    "email_address": "${HORIZON_EMAIL_ADDRESS}",
    "password_env": "SMTP_PASSWORD",
    "recipients": [
      "${HORIZON_EMAIL_ADDRESS}"
    ],
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE",
    "imap_enabled": false,
    "languages": [
      "zh"
    ]
  },
