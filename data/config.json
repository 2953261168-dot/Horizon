{
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash",
    "api_key_env": "ZHIPU_API_KEY",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "temperature": 0.1,
    "max_tokens": 4096,
    "throttle_sec": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "language": "zh",
    "profile_settings": {
      "tech-news": {
        "threshold": 1.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "2953261168@qq.com",
    "password_env": "SMTP_PASSWORD",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 10,
      "min_score": 50,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "金融时报 (FT)",
        "url": "https://www.ft.com/rss/home",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "OpenAI 官方博客",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "Simon Willison (AI 深度博客)",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "name": "Reddit - Technology",
        "url": "https://rsshub.app/reddit/r/technology/hot",
        "enabled": true,
        "profile": "tech-news"
      }
    ]
  }
}
