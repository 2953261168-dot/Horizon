{
  "ai": {
    "provider": "openai",
    "model": "glm-4-flash",
    "api_key_env": "ZHIPU_API_KEY",
    "base_url": "https://open.bigmodel.cn/api/paas/v4/",
    "temperature": 0.1,
    "max_tokens": 4096,
    "throttle_sec": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 15
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "imap_server": "imap.163.com",
    "imap_port": 993,
    "email_address": "19141079030@163.com",
    "password_env": "SMTP_PASSWORD",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "profile": "tech-news"
    },
    "github": [
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "金融时报 (FT)",
        "url": "https://www.ft.com/rss/home",
